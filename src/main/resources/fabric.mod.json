{
  "schemaVersion": 1,
  "id": "vaaw",
  "version": "${version}",
  "name": "Void's Artifacts and Weapons",
  "description": "Adds unique Artifacts and Weapons to Minecraft!",
  "authors": [
    "VoidVA",
    "Mako",
    "FlorianDH",
    "nuxlox"
  ],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      {
        "value": "vee.vaaw.VaawDataGenerator",
        "adapter": "kotlin"
      }

    ],
    "client": [
      {
        "value": "vee.vaaw.VaawClient"
      }
    ],
    "main": [
      {
        "value": "vee.vaaw.Vaaw"
      }
    ]
  },
  "mixins": [
    "vaaw.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "nuxon": "*"
  }
}
